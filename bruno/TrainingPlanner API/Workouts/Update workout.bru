meta {
  name: Update workout
  type: http
  seq: 2
}

put {
  url: {{baseUrl}}/workouts/{{workoutId}}
  body: json
  auth: none
}

headers {
  API-KEY: {{apiKey}}
  Content-Type: application/json
}

body:json {
  {
    "id": {{workoutId}},
    "userId": {{userId}},
    "trainingPlanId": {{planId}},
    "name": "Updated interval workout",
    "description": "Updated speed session",
    "durationMinutes": 55,
    "distanceMeters": 9000,
    "pace": 5.4,
    "paceUnit": "min/km",
    "notes": null,
    "segments": []
  }
}
