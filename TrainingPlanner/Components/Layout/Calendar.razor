<div>
    <div>
        <h1>@monthNames[currentMonth.Month - 1] @currentMonth.Year</h1>
    </div>

    <table>
        <thead>
            <tr>
                @foreach (string weekDay in weekDaysNamesShort)
                {
                    <th>@weekDay</th>
                }
            </tr>
        </thead>
        <tbody>
            @for (int row = 0; row < 6; row++)
            {
                <tr>
                    @for (int col = 0; col < 7; col++)
                    {
                        DateTime day = calendarDays[row * 7 + col];
                        <td class="@(day.Month == currentMonth.Month ? "current-month" : "other-month")">
                            
                            @if (day.Day == 1 || day.Day == DateTime.DaysInMonth(day.Year, day.Month)) {
                                <p>@day.Day @monthNames[day.Month - 1].Substring(0,3)</p>  
                            } else {
                                <p>@day.Day</p>
                            }
                            <div>
                                
                            </div>

                        </td>
                    }
                </tr>
            }
        </tbody>
    </table>
</div>

<style>
    table {
        border-collapse: collapse;
        width: 100%;
    }
    tr {
        height: 75px;
    }
    th, td {
        width: 14%;
    }
    th {
        padding: 0.5rem;
        text-align: right;
    }

    td {
        border: 1px solid #ddd;
        padding: 0.5rem;
        text-align: right;
        vertical-align: top;
    }
    td p {
        margin: 0px;
    }

    .other-month {
        color: #999;
    }

    .current-month {
        color: #222;
    }
</style>

@code {
    private DateTime currentMonth = new DateTime(DateTime.Today.Year, DateTime.Today.Month, 1);
    private string[] weekDaysNames = ["Monday", "Tuesday", "Wednesday", "Thursday", "Friday", "Saturday", "Sunday"];
    private string[] weekDaysNamesShort = ["Mon", "Tue", "Wed", "Thu", "Fri", "Sat", "Sun"];
    private string[] monthNames = ["January", "February", "March", "April", "May", "June", "July", "August", "September", "October", "November", "December"];

    private List<DateTime> calendarDays => GetCalendarDays(currentMonth);

    private List<DateTime> GetCalendarDays(DateTime month)
    {
        DateTime firstDayOfMonth = new DateTime(month.Year, month.Month, 1);
        int daysInMonth = DateTime.DaysInMonth(month.Year, month.Month);

        int leadingDays = ((int)firstDayOfMonth.DayOfWeek + 6) % 7;

        int totalCells = 42;
        int trailingDays = totalCells - leadingDays - daysInMonth;

        List<DateTime>? result = new List<DateTime>();

        for (int i = leadingDays; i > 0; i--)
        {
            result.Add(firstDayOfMonth.AddDays(-i));
        }

        for (int i = 0; i < daysInMonth; i++)
        {
            result.Add(firstDayOfMonth.AddDays(i));
        }

        DateTime nextMonthStart = firstDayOfMonth.AddMonths(1);
        for (int i = 0; i < trailingDays; i++)
        {
            result.Add(nextMonthStart.AddDays(i));
        }

        return result;
    }
}