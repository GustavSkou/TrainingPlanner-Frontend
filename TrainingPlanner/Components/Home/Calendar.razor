@using TrainingPlanner.Models

<aside class="sidebar">
    <div class="calendar-header">
        <h2>@CurrentMonth.ToString("MMMM yyyy")</h2>
        <button class="today-nav" @onclick="OnTodayClicked">Today</button>
        <div class="month-nav">
            <button class="nav-btn" @onclick="OnPreviousMonthClicked">&lt;</button>
            <button class="nav-btn" @onclick="OnNextMonthClicked">&gt;</button>
        </div>
    </div>

    <div class="calendar-grid">
        <div class="day-name">Mon</div>
        <div class="day-name">Tue</div>
        <div class="day-name">Wed</div>
        <div class="day-name">Thu</div>
        <div class="day-name">Fri</div>
        <div class="day-name">Sat</div>
        <div class="day-name">Sun</div>

        @foreach (var day in CalendarDays)
        {
            var plansForDay = GetPlansForDate(day.Date);
            <div class="date-cell @(day.IsCurrentMonth ? "" : "muted") @(day.Date == SelectedDate ? "active" : "")"
                 @onclick="() => OnSelectedDateChanged.InvokeAsync(day.Date)">
                <div class="date-number">@day.Date.Day</div>

                <div class="activity-dots">
                    @foreach (var plan in plansForDay)
                    {
                        <div class="dot @plan.TrainingType?.Name.ToLower()"></div>
                    }
                </div>
            </div>
        }
    </div>

    <div class="activity-guide">
        <div class="guide-legend">
            @foreach (var activityType in ActivityTypes)
            {
                <div class="guide-item @(activityType.Value.IsSelected ? "" : "inactive")"
                     @onclick="() => OnToggleActivityType.InvokeAsync(activityType.Value)">
                    <div class="dot @activityType.Value.Name.ToLower()"></div> @activityType.Value.Name
                </div>
            }
        </div>
    </div>
</aside>

@code {
    [Parameter] public DateTime CurrentMonth { get; set; }
    [Parameter] public DateTime SelectedDate { get; set; }
    [Parameter] public IReadOnlyList<CalendarDay> CalendarDays { get; set; } = Array.Empty<CalendarDay>();
    [Parameter] public IReadOnlyDictionary<int, TrainingTypeDTO> ActivityTypes { get; set; } = new Dictionary<int, TrainingTypeDTO>();
    [Parameter] public IReadOnlyList<TrainingPlanDTO> TrainingPlans { get; set; } = Array.Empty<TrainingPlanDTO>();
    [Parameter] public EventCallback<DateTime> OnSelectedDateChanged { get; set; }
    [Parameter] public EventCallback<DateTime> OnCurrentMonthChanged { get; set; }
    [Parameter] public EventCallback<TrainingTypeDTO> OnToggleActivityType { get; set; }

    private IReadOnlyList<TrainingPlanDTO> GetPlansForDate(DateTime date)
    {
        return TrainingPlans
            .Where(p => p.Date.Date == date.Date &&
                        (p.TrainingType == null || p.TrainingType.IsSelected))
            .ToList();
    }

    private Task OnPreviousMonthClicked()
    {
        return OnCurrentMonthChanged.InvokeAsync(CurrentMonth.AddMonths(-1));
    }

    private Task OnNextMonthClicked()
    {
        return OnCurrentMonthChanged.InvokeAsync(CurrentMonth.AddMonths(1));
    }

    private Task OnTodayClicked()
    {
        return Task.WhenAll(
            OnSelectedDateChanged.InvokeAsync(DateTime.Today),
            OnCurrentMonthChanged.InvokeAsync(DateTime.Today));
    }
}