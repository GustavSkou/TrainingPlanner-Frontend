@using TrainingPlanner.Models

<style>
    .weekly-summary { display: flex; flex-direction: column; gap: 4px; min-width: 0; padding: 9px 8px; border-left: 1px solid #e5eaf1; border-bottom: 1px solid #e5eaf1; background: #fbfcfe; color: #68758a; font-size: 12px; }
    .weekly-summary strong { color: #68758a; font-size: 8px; font-weight: 600; }
    .weekly-summary b { color: #273247; font-size: 9px; font-weight: 600; }
    .weekly-summary dl { display: flex; flex-direction: column; gap: 3px; margin: 2px 0 0; }
    .weekly-summary dl div { display: flex; justify-content: space-between; gap: 5px; }
    .weekly-summary dt { color: #8290a6; }
    .weekly-summary dd { margin: 0; color: #273247; font-weight: 600; }
</style>

<div class="weekly-summary">
    <dl>
        <div><dt>Workouts</dt><dd>@weekPlans.Count</dd></div>
        <div><dt>Distance</dt><dd>@($"{GetDistanceKm():0.0} km")</dd></div>
        <div><dt>Duration</dt><dd>@FormatDuration(GetDurationMinutes())</dd></div>
    </dl>
</div>

@code {
    [Parameter] public DateTime weekStart { get; set; }
    [Parameter] public DateTime weekEnd { get; set; }
    [Parameter] public List<TrainingPlanDTO> weekPlans { get; set; }

    private decimal GetDistanceKm()
    {
        return weekPlans.Sum(plan => plan.Workout?.DistanceMeters ?? 0) / 1000m;
    }

    private int GetDurationMinutes()
    {
        return weekPlans.Sum(plan => plan.Workout?.DurationMinutes ?? 0);
    }

    private static string FormatDuration(int minutes)
    {
        var hours = minutes / 60;
        var remainingMinutes = minutes % 60;
        return hours > 0 ? $"{hours}h {remainingMinutes:00}m" : $"{remainingMinutes}m";
    }
}

