@using TrainingPlanner.Models
@using TrainingPlanner.Services.Contracts
@using System.Globalization
@inject IAgendaService AgendaService

<main class="agenda @(!ShowForm ? "agenda-hidden" : "")">
    <EditForm Model="_newTrainingPlan" OnSubmit="SaveWorkout">
        <header class="editor-topbar">
            <div class="breadcrumbs">← <button type="button" @onclick="ToggleForm">Training calendar</button> <span>/</span> Edit workout</div>
            <button type="button" class="editor-close" @onclick="ToggleForm" aria-label="Close workout editor">×</button>
            <div class="editor-title"><h1>@(EditingPlan is null ? "Add workout" : "Edit workout")</h1><span class="draft-badge">Draft</span></div>
        </header>

        <div class="editor-layout">
            <aside class="editor-sidebar">
                <section class="editor-card">
                    <h2>Plan &amp; schedule</h2>
                    <p class="card-hint">The context for your next session.</p>
                    <div class="form-group">
                        <label for="workout-date">Scheduled date</label>
                        <InputDate id="workout-date" @bind-Value="_newTrainingPlan.Date" class="form-control" />
                    </div>
                    <div class="form-group">
                        <label>Training plan name</label>
                        <InputText @bind-Value="_newTrainingPlan.Name" class="form-control" placeholder="Optional plan name" />
                    </div>
                    <div class="form-group">
                        <label>Activity type</label>
                        <InputSelect @bind-Value="_newTrainingPlan.TrainingTypeId" @bind-Value:after="OnTrainingTypeChanged" class="form-control">
                            <option value="0">Select a type...</option>
                            @foreach (var type in ActivityTypes)
                            {
                                <option value="@type.Value.Id">@type.Value.Name</option>
                            }
                        </InputSelect>
                    </div>
                    <div class="form-group">
                        <label>Plan notes <small>Optional</small></label>
                        <InputTextArea @bind-Value="_newTrainingPlan.Description" class="form-control" placeholder="Add context for the day..." rows="3" />
                    </div>
                </section>
                <section class="editor-card glance-card">
                    <h2>At a glance</h2>
                    <div class="glance-values"><div><strong>@DisplayedDuration</strong><span>min:sec<br />Planned duration</span></div><div><strong>@DisplayedDistance</strong><span>@DistanceUnit<br />Planned distance</span></div></div>
                    <div class="glance-meta">☷ @_newTrainingPlan.Workout.Segments.Count steps</div>
                </section>
                <p class="editor-note">ⓘ Changes apply to this workout only, not the rest of your training plan.</p>
            </aside>

            <section class="editor-main">
                <section class="editor-card workout-details-card">
                    <div class="section-heading"><div><h2>Workout details</h2></div></div>
                    <div class="details-grid">
                        <div class="form-group"><label>Workout name</label><InputText @bind-Value="_newTrainingPlan.Workout.Name" class="form-control" placeholder="e.g., 5K intervals" /></div>
                        <div class="form-group measurement-choice">
                            <label>Primary measure</label>
                            
                            @if (_measurementMode == MeasurementMode.Duration)
                            {
                                <div class="unit-input"><InputNumber @bind-Value="_newTrainingPlan.Workout.DurationMinutes" class="form-control" min="0" /><span>min</span></div>
                            }
                            else
                            {
                                <div class="unit-input">
                                    @if (UsesKilometers)
                                    {
                                        <InputNumber @bind-Value="DistanceKilometers" class="form-control" min="0" step="0.1" />
                                    }
                                    else
                                    {
                                        <InputNumber @bind-Value="_newTrainingPlan.Workout.DistanceMeters" class="form-control" min="0" />
                                    }
                                    <span>@DistanceUnit</span>
                                </div>
                            }
                            <div class="choice-group">
                                <label><input type="radio" name="measure" checked="@(_measurementMode == MeasurementMode.Duration)" @onchange="() => SetMeasurementMode(MeasurementMode.Duration)" /> Duration</label>
                                <label><input type="radio" name="measure" checked="@(_measurementMode == MeasurementMode.Distance)" disabled="@IsWorkoutType" @onchange="() => SetMeasurementMode(MeasurementMode.Distance)" /> Distance</label>
                            </div>
                        </div>
                        @if (SupportsPace)
                        {
                            <div class="form-group pace-field">
                                <label>Pace <small>@PaceUnit</small></label>
                                <InputText @bind-Value="PaceText" class="form-control" placeholder="@(UsesClockPace ? "5:30" : "30")" />
                            </div>
                        }
                    </div>
                    <label class="notes-link">+ <InputText @bind-Value="_newTrainingPlan.Workout.Notes" placeholder="Add workout notes" /> <small>Optional</small></label>
                </section>

                <section class="editor-card steps-card">
                    <div class="section-heading"><div><h2>Workout steps</h2><p>Build your session in order. Select intervals before adding a repeat.</p></div><span class="step-count">@_newTrainingPlan.Workout.Segments.Count steps</span></div>
                    
                    @foreach (var segment in _newTrainingPlan.Workout.Segments.OrderBy(s => s.Order))
                    {
                        <article class="segment-card @(SelectedIntervals.Any() && _repeatSegment == segment ? "segment-selected" : "")">
                            <div class="segment-header">
                                <h3>
                                    <span class="drag-handle">⁙</span>
                                    <span class="step-number">@(segment.Order + 1)</span>
                                    @(string.IsNullOrWhiteSpace(segment.Notes) ? $"Step {segment.Order + 1}" : segment.Notes)
                                </h3>
                                    <div class="step-actions">
                                        <button type="button" class="btn-secondary repeat-action" @onclick="() => BeginRepeat(segment)">↻ Repeat</button>
                                        <button type="button" class="btn-remove" @onclick="() => RemoveSegment(segment)">-</button>
                                        <button type="button" class="btn-collapse">⌃</button>
                                    </div>
                            </div>
                            <div class="segment-fields form-row"><div class="form-group"><label>Step notes</label><InputText @bind-Value="segment.Notes" class="form-control" placeholder="Warm up, hard effort..." /></div></div>
                            
                            @foreach (var interval in segment.Intervals.OrderBy(i => i.Order))
                            {
                                <div class="interval-row @(SelectedIntervals.Contains(interval) ? "interval-selected" : "")">
                                    <input type="checkbox" class="interval-check" checked="@SelectedIntervals.Contains(interval)" @onchange="args => ToggleIntervalSelection(interval, args)" aria-label="Select interval @(interval.Order + 1) for repeat" />
                                    <span class="interval-number">@(interval.Order + 1)</span>
                                    <select class="form-control interval-type" value="@GetIntervalMode(interval)" @onchange="args => ChangeIntervalMode(interval, args)"><option value="open">Run</option><option value="distance">Distance</option><option value="time">Time</option></select>
                                    
                                    @if (GetIntervalMode(interval) == "distance") { 
                                        <InputNumber @bind-Value="interval.DistanceMeters" class="form-control" min="1" placeholder="Meters" /> 
                                    }
                                    else if (GetIntervalMode(interval) == "time") { 
                                        <InputNumber @bind-Value="interval.DurationSeconds" class="form-control" min="1" placeholder="Seconds" /> 
                                    }
                                    <InputNumber @bind-Value="interval.TargetPaceSecondsPerKm" class="form-control pace-input" min="0" placeholder="Target pace" />
                                    <InputText @bind-Value="interval.Notes" class="form-control interval-notes" placeholder="Interval notes · optional" />
                                    <button type="button" class="btn-remove" @onclick="() => RemoveInterval(segment, interval)" aria-label="Remove interval">×</button>
                                </div>
                            }
                            <div class="segment-footer"><button type="button" class="btn-secondary" @onclick="() => AddInterval(segment)">+ Add interval</button>@if (_isRepeatEditorOpen && _repeatSegment == segment) { <span class="repeat-editor-inline"><InputNumber @bind-Value="_repeatCount" class="form-control repeat-count" min="2" /> times <button type="button" class="btn-link" @onclick="ApplyRepeat">Apply</button></span> }</div>
                        </article>
                    }

                    <div class="bottom-actions"><button type="button" class="btn-secondary" @onclick="AddSegment">+ Add step</button><button type="button" class="btn-secondary repeat-action" @onclick="BeginRepeatForLastSegment">↻ Add repeat</button><span>Add a single effort or a repeating set of intervals.</span></div>
                </section>
                @if (!string.IsNullOrWhiteSpace(_errorMessage)) { <p class="form-error">@_errorMessage</p> }
            </section>
        </div>
        <footer class="editor-footer"><span>▣ Scheduled for @SelectedDate.ToString("dddd, MMMM d") <small>· Unsaved changes</small></span><div><button type="button" class="btn-cancel" @onclick="ToggleForm">Cancel</button><button type="submit" class="btn-submit">Save workout</button></div></footer>
    </EditForm>
</main>

@code {
    [Parameter] public DateTime SelectedDate { get; set; }
    [Parameter] public IReadOnlyList<TrainingPlanDTO> SelectedPlans { get; set; } = Array.Empty<TrainingPlanDTO>();
    [Parameter] public IReadOnlyDictionary<int, TrainingTypeDTO> ActivityTypes { get; set; } = new Dictionary<int, TrainingTypeDTO>();
    [Parameter] public List<TrainingPlanDTO> TrainingPlans { get; set; } = new();
    [Parameter] public bool ShowForm { get; set; }
    [Parameter] public TrainingPlanDTO? EditingPlan { get; set; }
    [Parameter] public EventCallback OnFormClosed { get; set; }
    [Parameter] public EventCallback OnWorkoutSaved { get; set; }

    private TrainingPlanDTO _newTrainingPlan = new() { Date = DateTime.Today };
    private bool _isFormExpanded;
    private bool _isRepeatEditorOpen;
    private int _repeatCount = 2;
    private SegmentDTO? _repeatSegment;
    private string? _errorMessage;
    private string workoutText => SelectedPlans.Count == 1 ? "workout" : "workouts";
    private HashSet<IntervalDTO> SelectedIntervals { get; } = new();
    private MeasurementMode _measurementMode = MeasurementMode.Duration;

    private bool IsWorkoutType =>
        IsActivity("workout") || IsActivity("strength");

    private bool SupportsPace =>
        !IsWorkoutType && !string.IsNullOrWhiteSpace(PaceUnit);

    private bool UsesKilometers =>
        IsActivity("running") || IsActivity("run") ||
        IsActivity("cycling") || IsActivity("cycle") || IsActivity("bike");

    private bool UsesClockPace =>
        IsActivity("running") || IsActivity("run") ||
        IsActivity("swimming") || IsActivity("swim");

    private string DistanceUnit => UsesKilometers ? "km" : "m";

    private decimal DistanceKilometers
    {
        get => _newTrainingPlan.Workout.DistanceMeters / 1000m;
        set => _newTrainingPlan.Workout.DistanceMeters = (int)Math.Round(value * 1000m);
    }

    private string PaceText
    {
        get => UsesClockPace
            ? FormatClockPace(_newTrainingPlan.Workout.Pace)
            : _newTrainingPlan.Workout.Pace?.ToString("0.##", CultureInfo.InvariantCulture) ?? string.Empty;
        set
        {
            _newTrainingPlan.Workout.Pace = ParsePace(value);
        }
    }

    private string DisplayedDuration => FormatDuration(CalculatedDurationMinutes);

    private string DisplayedDistance => UsesKilometers
        ? $"{CalculatedDistanceMeters / 1000m:0.##}"
        : $"{CalculatedDistanceMeters:0}";

    private decimal CalculatedDurationMinutes
    {
        get
        {
            if (SupportsPace && _newTrainingPlan.Workout.Pace is > 0 && _newTrainingPlan.Workout.DistanceMeters > 0)
            {
                var distance = UsesKilometers
                    ? _newTrainingPlan.Workout.DistanceMeters / 1000m
                    : _newTrainingPlan.Workout.DistanceMeters / 100m;
                return UsesClockPace
                    ? distance * _newTrainingPlan.Workout.Pace.Value
                    : distance / _newTrainingPlan.Workout.Pace.Value * 60m;
            }

            return _newTrainingPlan.Workout.DurationMinutes;
        }
    }

    private decimal CalculatedDistanceMeters
    {
        get
        {
            if (SupportsPace && _newTrainingPlan.Workout.Pace is > 0 && _newTrainingPlan.Workout.DurationMinutes > 0)
            {
                var distance = UsesClockPace
                    ? _newTrainingPlan.Workout.DurationMinutes / _newTrainingPlan.Workout.Pace.Value
                    : _newTrainingPlan.Workout.DurationMinutes / 60m * _newTrainingPlan.Workout.Pace.Value;
                return UsesKilometers ? distance * 1000m : distance * 100m;
            }

            return _newTrainingPlan.Workout.DistanceMeters;
        }
    }

    private string PaceUnit => ActivityTypes.GetValueOrDefault(_newTrainingPlan.TrainingTypeId)?.Name.ToLowerInvariant() switch
    {
        "running" or "run" => "min/km",
        "cycling" or "cycle" or "bike" => "km/h",
        "swimming" or "swim" => "min/100m",
        _ => string.Empty
    };

    private bool IsActivity(string name) =>
        string.Equals(ActivityTypes.GetValueOrDefault(_newTrainingPlan.TrainingTypeId)?.Name, name, StringComparison.OrdinalIgnoreCase);

    private static string FormatClockPace(decimal? pace)
    {
        if (pace is null or <= 0)
        {
            return string.Empty;
        }

        var totalSeconds = (int)Math.Round(pace.Value * 60m);
        return $"{totalSeconds / 60}:{totalSeconds % 60:00}";
    }

    private static string FormatDuration(decimal durationMinutes)
    {
        var totalSeconds = Math.Max(0, (int)Math.Round(durationMinutes * 60m));
        return $"{totalSeconds / 60}:{totalSeconds % 60:00}";
    }

    private decimal? ParsePace(string? value)
    {
        if (string.IsNullOrWhiteSpace(value))
        {
            return null;
        }

        if (UsesClockPace && value.Contains(':', StringComparison.Ordinal))
        {
            var parts = value.Split(':', 2);
            if (int.TryParse(parts[0], out var minutes) &&
                int.TryParse(parts[1], out var seconds))
            {
                return (minutes * 60m + seconds) / 60m;
            }
        }

        return decimal.TryParse(value, NumberStyles.Number, CultureInfo.InvariantCulture, out var pace)
            ? pace
            : _newTrainingPlan.Workout.Pace;
    }

    protected override void OnParametersSet()
    {
        if (ShowForm && !_isFormExpanded)
        {
            _isFormExpanded = true;
            if (EditingPlan is null)
            {
                ResetForm();
            }
            else
            {
                _newTrainingPlan = EditingPlan;
                _newTrainingPlan.Workout ??= new WorkoutDTO();
                _measurementMode = IsWorkoutType
                    ? MeasurementMode.Duration
                    : _newTrainingPlan.Workout.DistanceMeters > 0
                    ? MeasurementMode.Distance
                    : MeasurementMode.Duration;
                _newTrainingPlan.Workout.PaceUnit = PaceUnit;
                _errorMessage = null;
            }
        }
    }

    private async Task SaveWorkout()
    {
        _errorMessage = null;
        SelectedIntervals.Clear();
        _isRepeatEditorOpen = false;
        _repeatSegment = null;
        if (_newTrainingPlan.TrainingTypeId == 0)
        {
            _errorMessage = "Select an activity type before saving.";
            return;
        }

        if (IsWorkoutType)
        {
            _measurementMode = MeasurementMode.Duration;
            _newTrainingPlan.Workout.DistanceMeters = 0;
            _newTrainingPlan.Workout.Pace = null;
            _newTrainingPlan.Workout.PaceUnit = null;
        }
        else if (_measurementMode == MeasurementMode.Duration)
        {
            _newTrainingPlan.Workout.DistanceMeters = 0;
        }
        else
        {
            _newTrainingPlan.Workout.DurationMinutes = 0;
        }

        if (SupportsPace && _newTrainingPlan.Workout.Pace is > 0)
        {
            _newTrainingPlan.Workout.DurationMinutes = (int)Math.Round(CalculatedDurationMinutes);
            _newTrainingPlan.Workout.DistanceMeters = (int)Math.Round(CalculatedDistanceMeters);
        }

        _newTrainingPlan.Workout.PaceUnit = SupportsPace ? PaceUnit : null;
        _newTrainingPlan.Date = _newTrainingPlan.Date.Date;
        _newTrainingPlan.TrainingType = ActivityTypes[_newTrainingPlan.TrainingTypeId];
        if (string.IsNullOrWhiteSpace(_newTrainingPlan.Name))
        {
            _newTrainingPlan.Name = _newTrainingPlan.TrainingType.Name;
        }
        _newTrainingPlan.Workout ??= new WorkoutDTO();
        if (string.IsNullOrWhiteSpace(_newTrainingPlan.Workout.Name))
        {
            _newTrainingPlan.Workout.Name = _newTrainingPlan.TrainingType.Name;
        }

        try
        {
            TrainingPlanDTO savedPlan = _newTrainingPlan.Id.HasValue
                ? await AgendaService.UpdateTrainingPlanAsync(_newTrainingPlan)
                : await AgendaService.CreateTrainingPlanAsync(_newTrainingPlan);
            savedPlan.TrainingType ??= _newTrainingPlan.TrainingType;
            ReplaceOrAddPlan(savedPlan);
            _isFormExpanded = false;
            ResetForm();
            await OnFormClosed.InvokeAsync();
            await OnWorkoutSaved.InvokeAsync();
        }
        catch (HttpRequestException)
        {
            _errorMessage = "The workout could not be saved. Check the API connection and try again.";
        }
        catch (InvalidOperationException exception)
        {
            _errorMessage = exception.Message;
        }
    }

    private void ToggleForm()
    {
        _isFormExpanded = !_isFormExpanded;
        if (_isFormExpanded)
        {
            ResetForm();
        }
        else
        {
            _ = OnFormClosed.InvokeAsync();
        }
    }

    private void BeginEditing(TrainingPlanDTO plan)
    {
        _newTrainingPlan = plan;
        _newTrainingPlan.Date = plan.Date.Date;
        _newTrainingPlan.Workout ??= new WorkoutDTO();
        _isFormExpanded = true;
        _errorMessage = null;
    }

    private void ReplaceOrAddPlan(TrainingPlanDTO savedPlan)
    {
        int existingIndex = TrainingPlans.FindIndex(plan => plan.Id == savedPlan.Id && savedPlan.Id.HasValue);
        if (existingIndex >= 0)
        {
            TrainingPlans[existingIndex] = savedPlan;
        }
        else
        {
            TrainingPlans.Add(savedPlan);
        }
    }

    private void ResetForm()
    {
        _errorMessage = null;
        _newTrainingPlan = new TrainingPlanDTO
        {
            Date = SelectedDate,
            Workout = new WorkoutDTO()
        };
        SelectedIntervals.Clear();
        _isRepeatEditorOpen = false;
        _repeatSegment = null;
        _measurementMode = MeasurementMode.Duration;
    }

    private void OnTrainingTypeChanged()
    {
        if (IsWorkoutType)
        {
            SetMeasurementMode(MeasurementMode.Duration);
        }
    }

    private void SetMeasurementMode(MeasurementMode mode)
    {
        _measurementMode = IsWorkoutType ? MeasurementMode.Duration : mode;
        if (_measurementMode == MeasurementMode.Duration)
        {
            _newTrainingPlan.Workout.DistanceMeters = 0;
        }
        else
        {
            _newTrainingPlan.Workout.DurationMinutes = 0;
        }
    }

    private static SegmentDTO CreateSegment(int order) =>
        new() { Order = order, RepeatCount = 1, Intervals = new List<IntervalDTO> { CreateInterval(0) } };

    private static IntervalDTO CreateInterval(int order) => new() { Order = order };

    private void AddSegment() =>
        _newTrainingPlan.Workout.Segments.Add(CreateSegment(_newTrainingPlan.Workout.Segments.Count));

    private void RemoveSegment(SegmentDTO segment)
    {
        if (_newTrainingPlan.Workout.Segments.Count == 1)
        {
            return;
        }
        _newTrainingPlan.Workout.Segments.Remove(segment);
        foreach (var interval in segment.Intervals)
        {
            SelectedIntervals.Remove(interval);
        }
        if (_repeatSegment == segment)
        {
            _repeatSegment = null;
            _isRepeatEditorOpen = false;
        }
        ReorderSegments();
    }

    private static void AddInterval(SegmentDTO segment) =>
        segment.Intervals.Add(CreateInterval(segment.Intervals.Count));

    private void RemoveInterval(SegmentDTO segment, IntervalDTO interval)
    {
        segment.Intervals.Remove(interval);
        SelectedIntervals.Remove(interval);
        for (var index = 0; index < segment.Intervals.Count; index++)
        {
            segment.Intervals.ElementAt(index).Order = index;
        }
    }

    private void ToggleIntervalSelection(IntervalDTO interval, ChangeEventArgs args)
    {
        if (args.Value is true || string.Equals(args.Value?.ToString(), "true", StringComparison.OrdinalIgnoreCase))
        {
            SelectedIntervals.Add(interval);
        }
        else
        {
            SelectedIntervals.Remove(interval);
        }
    }

    private void BeginRepeat(SegmentDTO segment)
    {
        SelectedIntervals.Clear();
        _repeatCount = segment.RepeatCount > 1 ? segment.RepeatCount : 2;
        _repeatSegment = segment;
        _isRepeatEditorOpen = true;
    }

    private void BeginRepeatForLastSegment()
    {
        SegmentDTO? segment = _newTrainingPlan.Workout.Segments.LastOrDefault();
        if (segment is null)
        {
            AddSegment();
            segment = _newTrainingPlan.Workout.Segments.LastOrDefault();
        }

        if (segment is not null)
        {
            BeginRepeat(segment);
        }
    }

    private void CancelRepeat()
    {
        _isRepeatEditorOpen = false;
        SelectedIntervals.Clear();
        _repeatSegment = null;
    }

    private void ApplyRepeat()
    {
        if (_repeatSegment is null || SelectedIntervals.Count == 0 || _repeatCount < 2)
        {
            return;
        }

        var segment = _repeatSegment;
        var selected = segment.Intervals
            .Where(SelectedIntervals.Contains)
            .OrderBy(interval => interval.Order)
            .ToList();

        if (selected.Count == segment.Intervals.Count)
        {
            segment.RepeatCount = _repeatCount;
            SelectedIntervals.Clear();
            _isRepeatEditorOpen = false;
            _repeatSegment = null;
            return;
        }

        var repeatedSegment = new SegmentDTO
        {
            Order = segment.Order + 1,
            RepeatCount = _repeatCount,
            Intervals = selected
        };
        for (var index = 0; index < selected.Count; index++)
        {
            selected[index].Order = index;
        }
        foreach (var interval in selected)
        {
            segment.Intervals.Remove(interval);
        }
        var segments = _newTrainingPlan.Workout.Segments.ToList();
        segments.Insert(segment.Order + 1, repeatedSegment);
        _newTrainingPlan.Workout.Segments = segments;

        ReorderSegments();
        SelectedIntervals.Clear();
        _isRepeatEditorOpen = false;
        _repeatSegment = null;
    }

    private void ReorderSegments()
    {
        for (var index = 0; index < _newTrainingPlan.Workout.Segments.Count; index++)
        {
            _newTrainingPlan.Workout.Segments.ElementAt(index).Order = index;
        }
    }

    private static string GetIntervalMode(IntervalDTO interval) =>
        interval.DistanceMeters.HasValue ? "distance" :
        interval.DurationSeconds.HasValue ? "time" : "open";

    private static void ChangeIntervalMode(IntervalDTO interval, ChangeEventArgs args)
    {
        interval.DistanceMeters = null;
        interval.DurationSeconds = null;
        if (args.Value?.ToString() == "distance")
        {
            interval.DistanceMeters = 1;
        }
        else if (args.Value?.ToString() == "time")
        {
            interval.DurationSeconds = 1;
        }
    }

    private enum MeasurementMode
    {
        Duration,
        Distance
    }
}
