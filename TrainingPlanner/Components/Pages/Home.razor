@page "/"
@rendermode InteractiveServer
@using TrainingPlanner.Models

<style>
    :root {
        --color-blue: #006aff;
        --color-green: #34c759;
        --color-orange: #ff9500;
        --color-red: #ff3b30;
        --color-yellow: #ffcc00;
        --bg-main: #f8f9fa;
        --bg-card: #ffffff;
        --text-dark: #1a1a1a;
        --text-muted: #8e8e93;
        --border-color: #e5e5ea;
        --font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
        --page-horizontal-padding: 0px;
        --page-vertical-padding: 0px;
        --sidebar-width: 410px;
    }
</style>

<div class="app-window @(IsResizing ? "resizing" : "")" style="@AppWindowStyle" @onpointermove="OnPointerMove" @onpointerup="StopResizing" @onpointercancel="StopResizing">
    <div class="app-content">
        <aside class="sidebar">
            <div class="calendar-header">
                <h2>@_currentMonth.ToString("MMMM yyyy")</h2>
                <button class="today-nav" @onclick="OnClickToday">Today</button>
                <div class="month-nav">
                    <button class="nav-btn" @onclick="OnClickPreviousMonth">&lt;</button>
                    <button class="nav-btn" @onclick="OnClickNextMonth">&gt;</button>
                </div>
            </div>

            <div class="calendar-grid">
                
                <div class="day-name">Mon</div>
                <div class="day-name">Tue</div>
                <div class="day-name">Wed</div>
                <div class="day-name">Thu</div>
                <div class="day-name">Fri</div>
                <div class="day-name">Sat</div>
                <div class="day-name">Sun</div>

                @foreach (var day in _calendarDays)
                {
                    var plansForDay = GetPlansForDate(day.Date);
                    <div class="date-cell @(day.IsCurrentMonth ? "" : "muted") @(day.Date == _selectedDate ? "active" : "")" 
                         @onclick="() => SelectDate(day.Date)">
                        
                        <div class="date-number">@day.Date.Day</div>
                        
                        <div class="activity-dots">
                            @foreach (var plan in plansForDay)
                            {
                                <div class="dot @GetActivityClass(plan.TrainingType?.Name)"></div>
                            }
                        </div>
                    </div>
                }
            </div>

            <div class="activity-guide">
                <div class="guide-legend">
                    @foreach (var activityType in _activityTypes)
                    {
                        <div class="guide-item @(activityType.IsSelected ? "" : "inactive")" 
                             @onclick="() => ToggleActivityType(activityType)">
                            <div class="dot @GetActivityClass(activityType.Name)"></div> @activityType.Name
                        </div>
                    }
                </div>
            </div>
        </aside>

        <div class="resize-handle"
             @onpointerdown="StartResizing"
             @onpointerup="StopResizing"
             @onpointercancel="StopResizing"
             title="Drag to resize"></div>

        <main class="agenda">
            <div class="agenda-header">
                <h1>@_selectedDate.ToString("dddd, MMMM d")</h1>
                @{
                    var selectedPlans = GetPlansForDate(_selectedDate);
                    var workoutText = selectedPlans.Count == 1 ? "workout" : "workouts";
                }
                <p>Today &bull; @selectedPlans.Count @workoutText scheduled</p>
            </div>

            <div class="workout-list">
                @if (selectedPlans.Any())
                {
                    @foreach (var plan in selectedPlans)
                    {
                        <div class="workout-card">
                            <div class="workout-indicator @plan.TrainingType?.Name.ToLower()"></div>
                            <div class="workout-details">
                                <div class="workout-title">@(plan.Workout?.Name ?? plan.Name)</div>
                                <div class="workout-metrics">
                                    @if (plan.Workout != null)
                                    {
                                        @($"{(plan.Workout.DistanceMeters / 1000.0):0.0} km \u2022 {plan.Workout.DurationMinutes} min")
                                    }
                                </div>
                            </div>
                            <div class="chevron">&gt;</div>
                        </div>
                    }
                }
                else
                {
                    <div class="workout-metrics" style="padding: 16px 0;">No workouts scheduled (or filtered out).</div>
                }
            </div>

            <div class="add-workout-container @(_isFormExpanded ? "expanded" : "")">
                <button class="btn-add" @onclick="ToggleForm">
                    @(_isFormExpanded ? "- Cancel" : "+ Add Workout")
                </button>
                
                <div class="expandable-form">
                    <EditForm Model="_newTrainingPlan" OnSubmit="SaveWorkout">
                        <div class="form-group">
                            <label>Workout Name</label>
                            <InputText @bind-Value="_newTrainingPlan.Name" class="form-control" placeholder="e.g., Evening Run" required />
                        </div>

                        <div class="form-group">
                            <label>Date</label>
                            <InputDate @bind-Value="_newTrainingPlan.Date" class="form-control" required />
                        </div>

                        <div class="form-group">
                            <label>Activity Type</label>
                            <InputSelect @bind-Value="_newTrainingPlan.TrainingTypeId" class="form-control" required>
                                <option value="0">Select a type...</option>
                                @foreach (var type in _activityTypes)
                                {
                                    <option value="@type.Id">@type.Name</option>
                                }
                            </InputSelect>
                        </div>

                        <div class="form-group">
                            <label>Description</label>
                            <InputTextArea @bind-Value="_newTrainingPlan.Description" class="form-control" placeholder="Optional notes..." rows="3" />
                        </div>

                        <button type="submit" class="btn-submit">Save Plan</button>
                    </EditForm>
                </div>
            </div>

        </main>
    </div>
</div>

@code {
    private const double SidebarMinWidth = 410;
    private const double SidebarMaxWidth = 700;
    private bool _isFormExpanded = false;
    private TrainingPlanDTO _newTrainingPlan = new() { Date = DateTime.Today };

    private DateTime _currentMonth = DateTime.Today;
    private DateTime _selectedDate = DateTime.Today;
    private List<CalendarDay> _calendarDays = new();
    private double _sidebarWidth = SidebarMinWidth;
    private bool IsResizing;
    private double _resizeStartX;
    private double _resizeStartWidth;
    
    // Master list of available activity types
    private List<TrainingTypeDTO> _activityTypes = new();
    
    // Master list of training plans
    private List<TrainingPlanDTO> _trainingPlans = new();

    protected override void OnInitialized()
    {
        

        SeedDummyData();
        GenerateCalendar();
    }

    private string AppWindowStyle => $"--sidebar-width: {_sidebarWidth:0}px;";

    private void StartResizing(PointerEventArgs args)
    {
        IsResizing = true;
        _resizeStartX = args.ClientX;
        _resizeStartWidth = _sidebarWidth;
    }

    private void OnPointerMove(PointerEventArgs args)
    {
        if (!IsResizing)
        {
            return;
        }

        var nextWidth = _resizeStartWidth + (args.ClientX - _resizeStartX);
        _sidebarWidth = Math.Clamp(nextWidth, SidebarMinWidth, SidebarMaxWidth);
    }

    private void StopResizing(PointerEventArgs _)
    {
        IsResizing = false;
    }

    private void GenerateCalendar()
    {
        _calendarDays.Clear();
        
        var firstDayOfMonth = new DateTime(_currentMonth.Year, _currentMonth.Month, day: 1);
        var daysInMonth = DateTime.DaysInMonth(_currentMonth.Year, _currentMonth.Month);
        var startDayOfWeek = (int)firstDayOfMonth.DayOfWeek - 1; // week through mon - sun
        var startDate = firstDayOfMonth.AddDays(-startDayOfWeek);
        
        for (int i = 0; i < 42; i++)
        {
            var date = startDate.AddDays(i);
            _calendarDays.Add(new CalendarDay
            {
                Date = date,
                IsCurrentMonth = date.Month == _currentMonth.Month
            });
        }
    }

    private void SelectDate(DateTime date)
    {
        _selectedDate = date;
        _isFormExpanded = false;
    }

    private void OnClickPreviousMonth()
    {
        _currentMonth = _currentMonth.AddMonths(-1);
        GenerateCalendar();
    }

    private void OnClickNextMonth()
    {
        _currentMonth = _currentMonth.AddMonths(1);
        GenerateCalendar();
    }

    private void OnClickToday() {
        SelectDate(DateTime.Today);
        _currentMonth = _selectedDate;
        GenerateCalendar();
    }

    private void ToggleActivityType(TrainingTypeDTO activityType)
    {
        // Toggle the IsSelected property that was defined in TrainingTypeDTO
        activityType.IsSelected = !activityType.IsSelected;
    }

    private List<TrainingPlanDTO> GetPlansForDate(DateTime date)
    {
        // We only return plans for the specified date WHERE the associated TrainingType is currently selected/active.
        return _trainingPlans
            .Where(p => p.Date.Date == date.Date && 
                       (p.TrainingType == null || p.TrainingType.IsSelected))
            .ToList();
    }

    private string GetActivityClass(string? typeName)
    {
        return typeName?.ToLower() switch
        {
            "running" => "running",
            "swimming" => "swimming",
            "cycling" => "cycling",
            "strength" => "strength",
            _ => "running"
        };
    }

    private void ToggleForm()
    {
        _isFormExpanded = !_isFormExpanded;
        if (_isFormExpanded)
        {
            _newTrainingPlan = new TrainingPlanDTO { Date = _selectedDate };
        }
    }
    
    private void SaveWorkout()
    {
        // Require a valid Training Type selection before saving
        if (_newTrainingPlan.TrainingTypeId == 0) return;

        // Map the selected TrainingTypeId to the actual TrainingTypeDTO object
        _newTrainingPlan.TrainingType = _activityTypes.FirstOrDefault(t => t.Id == _newTrainingPlan.TrainingTypeId);
        
        // Add it to the master list
        _trainingPlans.Add(_newTrainingPlan);
        
        // Close the form and reset the model
        _isFormExpanded = false;
        _newTrainingPlan = new TrainingPlanDTO { Date = _selectedDate };
        
        // Refresh the UI state
        GenerateCalendar();
    }
    private void SeedDummyData()
    {
        // Initialize Master Types
        _activityTypes = new List<TrainingTypeDTO>
        {
            new TrainingTypeDTO(1, "Running", "Running workouts", true),
            new TrainingTypeDTO(2, "Cycling", "Cycling workouts", true),
            new TrainingTypeDTO(3, "Swimming", "Swimming workouts", true),
            new TrainingTypeDTO(4, "Strength", "Strength workouts", true)
        };

        var runType = _activityTypes.First(t => t.Name == "Running");
        var swimType = _activityTypes.First(t => t.Name == "Swimming");
        var cycleType = _activityTypes.First(t => t.Name == "Cycling");
        var strengthType = _activityTypes.First(t => t.Name == "Strength");

        // Seed Training Plans
        _trainingPlans = new List<TrainingPlanDTO>
        {
            // August 12
            new TrainingPlanDTO
            {
                Date = new DateTime(2026, 8, 12),
                Name = "Morning Routine",
                TrainingType = runType,
                Workout = new WorkoutDTO { Name = "Morning Run", DistanceMeters = 5200, DurationMinutes = 28 }
            },
            new TrainingPlanDTO
            {
                Date = new DateTime(2026, 8, 12),
                Name = "Afternoon Swim",
                TrainingType = swimType,
                Workout = new WorkoutDTO { Name = "Pool Swim", DistanceMeters = 1500, DurationMinutes = 35 }
            },
            
            // August 4 (Cycling)
            new TrainingPlanDTO { Date = new DateTime(2026, 8, 4), Name = "Cycling", TrainingType = cycleType },
            
            // August 6 (Running, Strength)
            new TrainingPlanDTO { Date = new DateTime(2026, 8, 6), Name = "Run", TrainingType = runType },
            new TrainingPlanDTO { Date = new DateTime(2026, 8, 6), Name = "Weights", TrainingType = strengthType },
            
            // August 8 (Strength)
            new TrainingPlanDTO { Date = new DateTime(2026, 8, 8), Name = "Weights", TrainingType = strengthType },
            
            // August 11 (Cycling)
            new TrainingPlanDTO { Date = new DateTime(2026, 8, 11), Name = "Cycling", TrainingType = cycleType },
            
            // August 14 (Strength)
            new TrainingPlanDTO { Date = new DateTime(2026, 8, 14), Name = "Weights", TrainingType = strengthType },
        };
    }

    private class CalendarDay
    {
        public DateTime Date { get; set; }
        public bool IsCurrentMonth { get; set; }
    }
}