@page "/"
@rendermode InteractiveServer
@inject NavigationManager _navigation
@inject AuthenticationStateProvider AuthenticationStateProvider

@using Microsoft.AspNetCore.Components.Authorization
@using TrainingPlanner.Models
@using TrainingPlanner.Services.Contracts
@using TrainingPlanner.Components.Home;
@inject ICalendarService CalendarService

<style>
    :root {
        --color-blue: #006aff;
        --color-green: #34c759;
        --color-orange: #ff9500;
        --color-red: #ff3b30;
        --color-yellow: #ffcc00;
        --bg-main: #f8f9fa;
        --bg-card: #ffffff;
        --text-dark: #1a1a1a;
        --text-muted: #8e8e93;
        --border-color: #e5e5ea;
        --font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
        --page-horizontal-padding: 0px;
        --page-vertical-padding: 0px;
        --sidebar-width: 410px;
    }
</style>

<AuthorizeView>
    <Authorized>
    <div class="app-window @(IsResizing ? "resizing" : "")" style="@AppWindowStyle" @onpointermove="OnPointerMove" @onpointerup="StopResizing" @onpointercancel="StopResizing">
        <div class="app-content">
            <Calendar CurrentMonth="_currentMonth"
                    SelectedDate="_selectedDate"
                    CalendarDays="_calendarDays"
                    ActivityTypes="_activityTypes"
                    TrainingPlans="_trainingPlans"
                    OnSelectedDateChanged="SelectDate"
                    OnCurrentMonthChanged="SetCurrentMonth"
                    OnToggleActivityType="ToggleActivityType" />

            <div class="resize-handle"
                @onpointerdown="StartResizing"
                @onpointerup="StopResizing"
                @onpointercancel="StopResizing"
                title="Drag to resize"></div>

            <Agenda SelectedDate="_selectedDate"
                    SelectedPlans="GetSelectedPlans()"
                    GenerateCalendar="GenerateCalendar()"
                    ActivityTypes="_activityTypes" 
                    TrainingPlans="_trainingPlans"/>
        </div>
    </div>
    </Authorized>
        
    <NotAuthorized>
        <Login/>
    </NotAuthorized>
</AuthorizeView>


@code {
    private const double SidebarMinWidth = 410;
    private const double SidebarMaxWidth = 700;

    private DateTime _currentMonth = DateTime.Today;
    private DateTime _selectedDate = DateTime.Today;
    private List<CalendarDay> _calendarDays = new();
    private double _sidebarWidth = SidebarMinWidth;
    private bool IsResizing;
    private double _resizeStartX;
    private double _resizeStartWidth;
    private Dictionary<int, TrainingTypeDTO> _activityTypes = new();
    private List<TrainingPlanDTO> _trainingPlans = new();

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();

        if (authState == null || 
            authState.User == null || 
            authState.User.Identity == null || 
            !authState.User.Identity.IsAuthenticated) 
        {
            _navigation.NavigateTo("login");
            return;
        }

        IReadOnlyList<TrainingTypeDTO>? types = await CalendarService.GetTypesAsync();
        _activityTypes = types.ToDictionary(t => t.Id, t => t);

        SeedDummyData();
        GenerateCalendar();
    }

    private string AppWindowStyle => $"--sidebar-width: {_sidebarWidth:0}px;";

    private void StartResizing(PointerEventArgs args)
    {
        IsResizing = true;
        _resizeStartX = args.ClientX;
        _resizeStartWidth = _sidebarWidth;
    }

    private void OnPointerMove(PointerEventArgs args)
    {
        if (!IsResizing)
        {
            return;
        }

        var nextWidth = _resizeStartWidth + (args.ClientX - _resizeStartX);
        _sidebarWidth = Math.Clamp(nextWidth, SidebarMinWidth, SidebarMaxWidth);
    }

    private void StopResizing(PointerEventArgs _)
    {
        IsResizing = false;
    }

    private Task SetCurrentMonth(DateTime month)
    {
        _currentMonth = month;
        GenerateCalendar();
        return Task.CompletedTask;
    }

    private Task SelectDate(DateTime date)
    {
        _selectedDate = date;
        return Task.CompletedTask;
    }

    private Task GenerateCalendar()
    {
        _calendarDays.Clear();

        var firstDayOfMonth = new DateTime(_currentMonth.Year, _currentMonth.Month, day: 1);
        var startDayOfWeek = (int)firstDayOfMonth.DayOfWeek - 1;
        var startDate = firstDayOfMonth.AddDays(-startDayOfWeek);

        for (int i = 0; i < 42; i++)
        {
            var date = startDate.AddDays(i);
            _calendarDays.Add(new CalendarDay
            {
                Date = date,
                IsCurrentMonth = date.Month == _currentMonth.Month
            });
        }
        return Task.CompletedTask;
    }

    private void ToggleActivityType(TrainingTypeDTO activityType)
    {
        activityType.IsSelected = !activityType.IsSelected;
    }

    private IReadOnlyList<TrainingPlanDTO> GetSelectedPlans()
    {
        return _trainingPlans
            .Where(p => p.Date.Date == _selectedDate.Date &&
                       (p.TrainingType == null || p.TrainingType.IsSelected))
            .ToList();
    }

    private void SeedDummyData()
    {
        _trainingPlans = new List<TrainingPlanDTO>
        {
            new TrainingPlanDTO
            {
                Date = new DateTime(2026, 8, 12),
                Name = "Morning Routine",
                TrainingType = _activityTypes[1],
                Workout = new WorkoutDTO { Name = "Morning Run", DistanceMeters = 5200, DurationMinutes = 28 }
            },
            new TrainingPlanDTO
            {
                Date = new DateTime(2026, 8, 12),
                Name = "Afternoon Swim",
                TrainingType = _activityTypes[3],
                Workout = new WorkoutDTO { Name = "Pool Swim", DistanceMeters = 1500, DurationMinutes = 35 }
            },
            new TrainingPlanDTO { Date = new DateTime(2026, 8, 4), Name = "Cycling", TrainingType = _activityTypes[2] },
            new TrainingPlanDTO { Date = new DateTime(2026, 8, 6), Name = "Run", TrainingType = _activityTypes[1] },
            new TrainingPlanDTO { Date = new DateTime(2026, 8, 6), Name = "Weights", TrainingType = _activityTypes[4] },
            new TrainingPlanDTO { Date = new DateTime(2026, 8, 8), Name = "Weights", TrainingType = _activityTypes[4] },
            new TrainingPlanDTO { Date = new DateTime(2026, 8, 11), Name = "Cycling", TrainingType = _activityTypes[2] },
            new TrainingPlanDTO { Date = new DateTime(2026, 8, 14), Name = "Weights", TrainingType = _activityTypes[4] },
        };
    }
}