@page "/register"
@rendermode InteractiveServer
@inject NavigationManager _navigation

<div class="login-shell">
    <div class="login-panel">
        <div class="login-badge">T</div>
        <h2>Create account</h2>
        <p>Sign up with GitHub to start tracking your training.</p>

        <button type="button" class="github-button" @onclick="RedirectToGitHubLogin">
            <svg class="github-img" viewBox="0 0 16 16" aria-hidden="true" focusable="false">
                <path d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.22 2.2.82A7.57 7.57 0 0 1 8 4.07c.68 0 1.37.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.01 8.01 0 0 0 16 8c0-4.42-3.58-8-8-8Z" fill="currentColor"/>
            </svg>
            Sign up with GitHub
        </button>

        <p class="switch-text">
            Already have an account?
            <a href="/login">Sign in</a>
        </p>
    </div>
</div>

<style>
    .login-shell {
        min-height: 100vh;
        display: flex;
        align-items: center;
        justify-content: center;
        background: linear-gradient(135deg, #f5f7ff 0%, #eef4ff 100%);
        padding: 24px;
    }

    .login-panel {
        width: min(100%, 420px);
        background: rgba(255, 255, 255, 0.96);
        border: 1px solid #e5e7eb;
        border-radius: 20px;
        box-shadow: 0 20px 45px rgba(15, 23, 42, 0.12);
        padding: 32px 28px;
        text-align: center;
    }

    .login-badge {
        width: 52px;
        height: 52px;
        margin: 0 auto 18px;
        border-radius: 14px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 1.4rem;
        font-weight: 700;
        color: white;
        background: linear-gradient(135deg, #111827 0%, #374151 100%);
    }

    .login-panel h2 {
        margin: 0;
        font-size: 2rem;
        font-weight: 700;
        color: #111827;
    }

    .login-panel p {
        margin: 10px 0 24px;
        color: #6b7280;
        font-size: 0.98rem;
    }

    .github-button {
        width: 100%;
        border: none;
        border-radius: 12px;
        background: #111827;
        color: white;
        font-size: 1rem;
        font-weight: 600;
        padding: 14px 18px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 10px;
        cursor: pointer;
        transition: transform 0.15s ease, box-shadow 0.15s ease, background 0.15s ease;
        box-shadow: 0 10px 18px rgba(17, 24, 39, 0.18);
    }

    .github-button:hover {
        transform: translateY(-1px);
        background: #1f2937;
    }

    .github-button:active {
        transform: translateY(0);
    }

    .github-img {
        width: 18px;
        height: 18px;
        flex-shrink: 0;
    }

    .switch-text {
        margin-top: 22px;
        font-size: 0.82rem;
        color: #6b7280;
    }

    .switch-text a {
        color: #111827;
        font-weight: 600;
        text-decoration: none;
    }

    .switch-text a:hover {
        text-decoration: underline;
    }
</style>

@code {
    private void RedirectToGitHubLogin()
    {
        _navigation.NavigateTo("/login/github");
    }
}